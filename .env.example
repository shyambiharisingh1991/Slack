# Copy this file to .env and fill in your values.
# For Heroku: set Config Vars in Dashboard (Settings → Reveal Config Vars).
# Do NOT commit .env to git.

# Required for Slack app
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: comma-separated Slack user IDs who can see admin/manager options on the home page
# Find your ID: In Slack, click your workspace name → Profile → click the three dots → Copy member ID
# Or in a channel, right-click your name → View profile → Copy member ID (looks like U01234ABCD)
ADMIN_USER_IDS=U0842C3D50W,U07DUN35U5Q

# Database (Heroku adds DATABASE_URL automatically when you add Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# March Accreditation module: video plays in the same modal (Slack video block).
# Set MARCH_ACCREDITATION_VIDEO_URL to a YouTube watch URL (we derive embed + thumbnail), or set
# MARCH_ACCREDITATION_VIDEO_EMBED_URL and MARCH_ACCREDITATION_VIDEO_THUMBNAIL_URL for other providers.
# Your Slack app needs scope links.embed:write and the video domain in Unfurl Domains (App config → Event Subscriptions / Link Unfurling).
# MARCH_ACCREDITATION_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
